<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Frosted glass body: slightly brighter at the top (light catches it) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/bar_fill"
                android:endColor="@color/bar_fill" />
            <corners android:radius="@dimen/app_corner" />
        </shape>
    </item>
    <!-- Thin top highlight only (2dp), fully rounded so it never reads as a box -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:height="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bar_gloss" />
            <corners android:radius="@dimen/app_corner" />
        </shape>
    </item>
</layer-list>
