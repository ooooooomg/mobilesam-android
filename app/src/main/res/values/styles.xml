<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Floating status chip (loading, status) -->
    <style name="HudChip">
        <item name="android:background">@drawable/bg_liquid_glass</item>
        <item name="android:paddingStart">@dimen/hud_padding_h</item>
        <item name="android:paddingEnd">@dimen/hud_padding_h</item>
        <item name="android:paddingTop">@dimen/hud_padding_v</item>
        <item name="android:paddingBottom">@dimen/hud_padding_v</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/hud_text</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="TopBarTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/title_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="SectionHeader">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
</resources>
